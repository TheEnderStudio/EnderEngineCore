#include <Windows.h>
#include <Engine/Core/Macros.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION    EE_VERSION_MAJOR,EE_VERSION_MINOR,EE_VERSION_PATCH,0
PRODUCTVERSION EE_VERSION_MAJOR,EE_VERSION_MINOR,EE_VERSION_PATCH,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    0x0L
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "The Ender Studio\0"
			VALUE "FileDescription", "The Core Library of Ender Engine\0"
			VALUE "FileVersion", EE_STRINGFY(EE_VERSION_MAJOR) "." EE_STRINGFY(EE_VERSION_MINOR) "." EE_STRINGFY(EE_VERSION_PATCH) ".0\0"
			VALUE "InternalName", "EnderEngineCore\0"
			VALUE "OriginalFilename", "EnderEngineCore.dll\0"
			VALUE "ProductName", "Ender Engine Core\0"
			VALUE "ProductVersion", EE_STRINGFY(EE_VERSION_MAJOR) "." EE_STRINGFY(EE_VERSION_MINOR) "." EE_STRINGFY(EE_VERSION_PATCH) ".0\0"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END